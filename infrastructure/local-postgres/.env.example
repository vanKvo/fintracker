# Copy to .env and set the values. .env is git-ignored.
#
# POSTGRES_PASSWORD: the superuser password. The Ledger's compose file currently hardcodes DB_PASSWORD=mysecretpassword,
#                    so use the same value unless you change that file too.
# KNOWLEDGE_DB_*_PASSWORD: the passwords for Knowledge's login roles. Use the same values as Knowledge's .env.local.
#                          They are read only on the first start of an empty volume; changing them later does not change the roles.
POSTGRES_PASSWORD=mysecretpassword
KNOWLEDGE_DB_RETRIEVE_PASSWORD=change-me
KNOWLEDGE_DB_INGEST_PASSWORD=change-me
